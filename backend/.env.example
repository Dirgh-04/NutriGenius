# NutriGenius AI Environment Variables (Template)
# Copy this file to .env and provide your local/production settings

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Open Food Facts API
# Recommended user-agent format: AppName/Version (contact-email-or-website)
OPENFOODFACTS_USER_AGENT=NutriGenius/1.0 (https://github.com/nutrigenius/nutrigenius)

# TheMealDB API
# Free test tier key is typically '1'
THEMEALDB_API_KEY=1
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# Fruityvice API
FRUITYVICE_BASE_URL=https://www.fruityvice.com

# Spoonacular API (Optional advanced integration)
# Leave empty if not using Spoonacular
SPOONACULAR_API_KEY=
SPOONACULAR_BASE_URL=https://api.spoonacular.com

# Supabase Configuration (Optional for initial demo, required for authentication & persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
